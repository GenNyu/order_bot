# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather

# Tuỳ chọn — danh sách quán mặc định cho group chưa tự thêm quán.
# Group nào dùng /add hoặc /del thì từ đó dùng danh sách riêng, không đọc biến này nữa.
# (Tên cũ DRINKS vẫn chạy được.)
SHOPS=Bé Hai Trà|Tiệm Trà Nè|3 Cô|Chủ nhật|Thứ 2|Crane|Toco|Má mía

# Tuỳ chọn — nơi lưu dữ liệu quán + người.
# Chạy Docker thì KHÔNG cần set, Dockerfile đã để sẵn /data/pics.json.
# DATA_FILE=pics.json
